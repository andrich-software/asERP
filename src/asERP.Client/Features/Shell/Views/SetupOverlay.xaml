<UserControl x:Class="asERP.Client.Features.Shell.Views.SetupOverlay"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     mc:Ignorable="d"
     d:DesignHeight="800"
     d:DesignWidth="1280">

  <Grid Background="{ThemeResource SurfaceVariantBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Brand bar (mirrors Sidebar brand row + ContentHeader) -->
    <Grid Grid.Row="0"
          Background="{ThemeResource BackgroundBrush}"
          BorderBrush="{ThemeResource OutlineVariantBrush}"
          BorderThickness="0,0,0,1"
          Padding="12,0,12,0">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Icons/icon.svg"
               Width="28"
               Height="28"
               Stretch="Uniform"
               VerticalAlignment="Center" />
        <TextBlock Text="asERP"
                   Style="{StaticResource BodyMedium}"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource OnSurfaceBrush}"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
      <StackPanel Spacing="24"
                  Padding="24"
                  MaxWidth="500"
                  HorizontalAlignment="Center">

        <StackPanel Spacing="8"
                    HorizontalAlignment="Center">
          <TextBlock x:Uid="Shell.Setup.Title"
                     Style="{StaticResource HeadlineSmall}"
                     Foreground="{ThemeResource OnSurfaceBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
          <TextBlock x:Uid="Shell.Setup.Subtitle"
                     Style="{StaticResource BodyLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="SetupErrorBanner"
                Background="{ThemeResource ErrorContainerBrush}"
                CornerRadius="8"
                Padding="16"
                Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      Glyph="&#xE783;"
                      FontSize="20"
                      Foreground="{ThemeResource OnErrorContainerBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center" />
            <TextBlock x:Name="SetupErrorText"
                       Grid.Column="1"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnErrorContainerBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Superadmin account -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
          <StackPanel Spacing="0">
            <Grid Padding="16,16,16,8">
              <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE7EF;"
                          FontSize="20"
                          Foreground="{ThemeResource PrimaryBrush}"
                          Margin="0,0,12,0" />
                <TextBlock x:Uid="Shell.Setup.AdminFormTitle"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{ThemeResource OnSurfaceBrush}" />
              </StackPanel>
            </Grid>

            <StackPanel Padding="16,0,16,16"
                        Spacing="16">
              <TextBox x:Name="SetupFirstname"
                       x:Uid="Shell.Register.Firstname" />

              <TextBox x:Name="SetupLastname"
                       x:Uid="Shell.Register.Lastname" />

              <TextBox x:Name="SetupEmail"
                       x:Uid="Shell.Register.Email"
                       InputScope="EmailSmtpAddress"
                       AutomationProperties.AutomationId="setup-email" />

              <PasswordBox x:Name="SetupPassword"
                           x:Uid="Shell.Register.Password"
                           AutomationProperties.AutomationId="setup-password" />

              <PasswordBox x:Name="SetupPasswordConfirm"
                           x:Uid="Shell.Register.PasswordConfirm" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- First tenant -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
          <StackPanel Spacing="0">
            <Grid Padding="16,16,16,8">
              <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE902;"
                          FontSize="20"
                          Foreground="{ThemeResource PrimaryBrush}"
                          Margin="0,0,12,0" />
                <TextBlock x:Uid="Shell.Setup.TenantFormTitle"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{ThemeResource OnSurfaceBrush}" />
              </StackPanel>
            </Grid>

            <StackPanel Padding="16,0,16,16"
                        Spacing="16">
              <TextBox x:Name="SetupTenantName"
                       x:Uid="TenantEditPage.Field.Name"
                       AutomationProperties.AutomationId="setup-tenant-name" />

              <TextBox x:Name="SetupTenantDescription"
                       x:Uid="TenantEditPage.Field.Description"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="80"
                       MaxHeight="120" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="16">
          <ProgressRing x:Name="SetupProgress"
                        IsActive="False"
                        Width="24"
                        Height="24"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SetupCancelButton"
                    Grid.Column="0"
                    x:Uid="Shell.Setup.Cancel"
                    Style="{StaticResource OutlinedButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="SetupCancel_Click" />
            <Button x:Name="SetupSubmitButton"
                    Grid.Column="1"
                    x:Uid="Shell.Setup.Submit"
                    Style="{StaticResource FilledButtonStyle}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="setup-submit"
                    Click="SetupSubmit_Click" />
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
