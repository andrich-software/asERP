<Page x:Class="asERP.Client.Features.Categories.Views.CategoryEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:asERP.Client.Features.Categories.Views"
      xmlns:models="using:asERP.Client.Features.Categories.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:asERP.Client.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header with NavigationBar -->
    <utu:NavigationBar Grid.Row="0"
                       Content="{Binding Title}">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton x:Uid="CategoryEditPage.AppBarButton.Cancel"
                      Click="CancelButton_Click">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE711;" />
          </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Uid="CategoryEditPage.AppBarButton.Save"
                      Click="SaveButton_Click"
                      IsEnabled="{Binding CanSave}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE74E;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- Form Content -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="24"
                  Spacing="16"
                  MaxWidth="700"
                  HorizontalAlignment="Stretch">

        <!-- Error Message Banner -->
        <Border Background="{ThemeResource ErrorContainerBrush}"
                CornerRadius="8"
                Padding="16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
          <TextBlock Text="{Binding ErrorMessage}"
                     Style="{StaticResource BodyMedium}"
                     Foreground="{ThemeResource OnErrorContainerBrush}"
                     TextWrapping="Wrap" />
        </Border>

        <controls:SectionCard x:Uid="CategoryEditPage.BasicCard"
                              HeaderGlyph="&#xE71D;">
          <StackPanel Spacing="12">
            <TextBox x:Uid="CategoryEditPage.NameBox"
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNotLoading}" />

            <TextBox x:Uid="CategoryEditPage.SlugBox"
                     Text="{Binding Slug, Mode=TwoWay}"
                     IsEnabled="{Binding IsNotLoading}" />

            <ComboBox x:Uid="CategoryEditPage.ParentBox"
                      ItemsSource="{Binding ParentOptions}"
                      SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                      IsEnabled="{Binding IsNotLoading}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryParentOption">
                  <TextBlock Text="{x:Bind Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <NumberBox x:Uid="CategoryEditPage.SortOrderBox"
                       Value="{Binding SortOrder, Mode=TwoWay}"
                       SpinButtonPlacementMode="Inline"
                       SmallChange="1"
                       Minimum="0"
                       IsEnabled="{Binding IsNotLoading}" />

            <TextBox x:Uid="CategoryEditPage.DescriptionBox"
                     Text="{Binding Description, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="120"
                     IsEnabled="{Binding IsNotLoading}" />
          </StackPanel>
        </controls:SectionCard>

        <!-- Delete (edit mode only, confirmed via dialog; server rejects while children exist) -->
        <Button x:Uid="CategoryEditPage.DeleteButton"
                Style="{StaticResource OutlinedButtonStyle}"
                Foreground="{ThemeResource ErrorBrush}"
                HorizontalAlignment="Left"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                IsEnabled="{Binding IsNotLoading}"
                Click="DeleteButton_Click" />

        <ProgressRing IsActive="{Binding IsLoading}"
                      Width="32"
                      Height="32"
                      HorizontalAlignment="Center"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
