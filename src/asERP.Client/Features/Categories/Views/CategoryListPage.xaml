<Page x:Class="asERP.Client.Features.Categories.Views.CategoryListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:asERP.Client.Features.Categories.Views"
      xmlns:models="using:asERP.Client.Features.Categories.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:asERP.Client.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- asERP-style page header: big title + description, actions top-right -->
    <controls:PageHeader Grid.Row="0"
                         x:Uid="CategoryListPage.PageHeader"
                         Glyph="&#xE8FD;"
                         Margin="16,0">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Style="{StaticResource OutlinedButtonStyle}"
                  x:Uid="CategoryListPage.RefreshButton"
                  Click="Refresh_Click">
            <FontIcon Glyph="&#xE72C;" FontSize="16" />
          </Button>
          <Button x:Uid="CategoryListPage.DiscardButton"
                  Style="{StaticResource OutlinedButtonStyle}"
                  Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                  Click="Discard_Click" />
          <Button x:Uid="CategoryListPage.SaveButton"
                  Style="{StaticResource OutlinedButtonStyle}"
                  IsEnabled="{Binding CanSave}"
                  Click="Save_Click" />
          <Button x:Uid="CategoryListPage.HeaderButton.New"
                  Style="{StaticResource FilledButtonStyle}"
                  Click="CreateCategory_Click" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!-- Search Box -->
    <Grid Grid.Row="1"
          Margin="16,12,16,8">
      <TextBox x:Name="SearchBox"
               x:Uid="CategoryListPage.SearchBox"
               TextChanged="SearchBox_TextChanged"
               Padding="40,0,12,0" />
      <FontIcon Glyph="&#xE721;"
                FontSize="16"
                Foreground="{ThemeResource OnSurfaceVariantBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                IsHitTestVisible="False" />
    </Grid>

    <!-- Error Message Banner -->
    <Border Grid.Row="2"
            Background="{ThemeResource ErrorContainerBrush}"
            CornerRadius="8"
            Padding="12"
            Margin="16,0,16,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
      <TextBlock Text="{Binding ErrorMessage}"
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnErrorContainerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Category matrix: fixed name/product columns + one checkbox column per shop channel -->
    <Border Grid.Row="3"
            Margin="16,0,16,16"
            Style="{StaticResource TableCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Table Header (fixed cell widths keep header and rows aligned) -->
        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8,8,0,0"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Uid="CategoryListPage.Header.Name"
                       Style="{StaticResource LabelLarge}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center"
                       Padding="16,12" />
            <TextBlock Grid.Column="1"
                       x:Uid="CategoryListPage.Header.Products"
                       Style="{StaticResource LabelLarge}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center"
                       Padding="8,12" />
            <ItemsControl Grid.Column="2"
                          Margin="0,0,16,0"
                          ItemsSource="{Binding ChannelColumns}"
                          VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryChannelColumn">
                  <TextBlock Width="90"
                             Text="{x:Bind Name}"
                             ToolTipService.ToolTip="{x:Bind Name}"
                             Style="{StaticResource LabelLarge}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Padding="0,12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- Table Body -->
        <Grid Grid.Row="1">
          <ListView ItemsSource="{Binding Rows}"
                    Style="{StaticResource TableListViewStyle}"
                    ItemContainerStyle="{StaticResource TableItemContainerStyle}"
                    ItemClick="CategoryRow_Click">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:CategoryRow">
                <Grid BorderBrush="{ThemeResource OutlineVariantBrush}"
                      BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Name, indented by tree depth -->
                  <TextBlock Grid.Column="0"
                             Text="{x:Bind Name}"
                             Margin="{x:Bind NameIndent}"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceBrush}"
                             VerticalAlignment="Center"
                             Padding="16,14"
                             TextTrimming="CharacterEllipsis" />

                  <!-- Assigned product count -->
                  <TextBlock Grid.Column="1"
                             Text="{x:Bind ProductCount}"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center"
                             Padding="8,14" />

                  <!-- One checkbox per shop channel (same fixed width as the header cells) -->
                  <ItemsControl Grid.Column="2"
                                Margin="0,0,16,0"
                                ItemsSource="{x:Bind Cells}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CategoryChannelCell">
                        <Grid Width="90">
                          <CheckBox IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                    MinWidth="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <controls:EmptyState x:Uid="CategoryListPage.NoCategories"
                               Glyph="&#xE8FD;"
                               Background="Transparent"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasCategories, Converter={StaticResource BoolToInverseVisibilityConverter}}" />

          <ProgressRing IsActive="{Binding IsLoading}"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
