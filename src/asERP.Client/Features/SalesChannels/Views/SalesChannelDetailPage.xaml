<Page x:Class="asERP.Client.Features.SalesChannels.Views.SalesChannelDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:asERP.Client.Features.SalesChannels.Views"
      xmlns:models="using:asERP.Client.Features.SalesChannels.Models"
      xmlns:dtos="using:asERP.Domain.Dtos.SalesChannel"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:asERP.Client.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header with back button -->
    <utu:NavigationBar Grid.Row="0" x:Uid="SalesChannelDetailPage.NavigationBar">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back"
                      x:Uid="SalesChannelDetailPage.AppBarButton.Back"
                      Click="BackButton_Click" />
      </utu:NavigationBar.MainCommand>
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Icon="Edit"
                      x:Uid="SalesChannelDetailPage.AppBarButton.Edit"
                      Click="EditButton_Click" />
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <!-- Tabs: Settings | Log -->
    <utu:TabBar x:Name="DetailTabs"
                Grid.Row="1"
                Margin="24,8,24,0"
                HorizontalAlignment="Left"
                Style="{StaticResource MaterialTopTabBarStyle}"
                Loaded="DetailTabs_Loaded"
                SelectionChanged="DetailTabs_SelectionChanged">
      <utu:TabBar.Items>
        <utu:TabBarItem x:Uid="SalesChannelDetailPage.TabSettings"
                        Style="{StaticResource MaterialTopTabBarItemStyle}"
                        IsSelected="True" />
        <utu:TabBarItem x:Uid="SalesChannelDetailPage.TabLog"
                        Style="{StaticResource MaterialTopTabBarItemStyle}" />
      </utu:TabBar.Items>
    </utu:TabBar>

    <!-- Tab content -->
    <Grid Grid.Row="2">

      <!-- Tab: Settings (read-only channel configuration) -->
      <Grid x:Name="SettingsTab">
        <mvux:FeedView Source="{Binding SalesChannel}">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="24">
              <!-- VisualStateManager for responsive layout -->
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                  <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                      <Setter Target="ContentStack.MaxWidth" Value="500" />
                      <Setter Target="SyncGrid.MaxWidth" Value="500" />
                      <Setter Target="SyncColumn1.Width" Value="*" />
                      <Setter Target="SyncColumn2.Width" Value="0" />
                      <Setter Target="ImportCard.(Grid.Column)" Value="0" />
                      <Setter Target="ImportCard.(Grid.Row)" Value="0" />
                      <Setter Target="ImportCard.Margin" Value="0,0,0,16" />
                      <Setter Target="ExportCard.(Grid.Column)" Value="0" />
                      <Setter Target="ExportCard.(Grid.Row)" Value="1" />
                      <Setter Target="ExportCard.Margin" Value="0" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                      <Setter Target="ContentStack.MaxWidth" Value="700" />
                      <Setter Target="SyncGrid.MaxWidth" Value="700" />
                      <Setter Target="SyncColumn1.Width" Value="*" />
                      <Setter Target="SyncColumn2.Width" Value="*" />
                      <Setter Target="ImportCard.(Grid.Column)" Value="0" />
                      <Setter Target="ImportCard.(Grid.Row)" Value="0" />
                      <Setter Target="ImportCard.Margin" Value="0,0,8,0" />
                      <Setter Target="ExportCard.(Grid.Column)" Value="1" />
                      <Setter Target="ExportCard.(Grid.Row)" Value="0" />
                      <Setter Target="ExportCard.Margin" Value="8,0,0,0" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                      <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                      <Setter Target="ContentStack.MaxWidth" Value="900" />
                      <Setter Target="SyncGrid.MaxWidth" Value="900" />
                      <Setter Target="SyncColumn1.Width" Value="*" />
                      <Setter Target="SyncColumn2.Width" Value="*" />
                      <Setter Target="ImportCard.(Grid.Column)" Value="0" />
                      <Setter Target="ImportCard.(Grid.Row)" Value="0" />
                      <Setter Target="ImportCard.Margin" Value="0,0,8,0" />
                      <Setter Target="ExportCard.(Grid.Column)" Value="1" />
                      <Setter Target="ExportCard.(Grid.Row)" Value="0" />
                      <Setter Target="ExportCard.Margin" Value="8,0,0,0" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <StackPanel x:Name="ContentStack"
                          Spacing="24"
                          MaxWidth="700"
                          HorizontalAlignment="Center">

                <!-- Hero Card with Name and Type -->
                <Border Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="16"
                        Padding="32" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                  <StackPanel HorizontalAlignment="Center"
                              Spacing="16">
                    <!-- Sales Channel Icon -->
                    <Border Width="80"
                            Height="80"
                            CornerRadius="40"
                            Background="{ThemeResource PrimaryContainerBrush}"
                            HorizontalAlignment="Center">
                      <FontIcon Glyph="&#xE8F1;"
                                FontSize="36"
                                Foreground="{ThemeResource OnPrimaryContainerBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>

                    <!-- Sales Channel Name -->
                    <TextBlock Text="{Binding Data.Name}"
                               Style="{StaticResource HeadlineMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <!-- Sales Channel Type Badge -->
                    <Border CornerRadius="16"
                            Padding="16,6"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource TertiaryContainerBrush}">
                      <TextBlock Text="{Binding Data.SalesChannelType}"
                                 Style="{StaticResource LabelMedium}"
                                 Foreground="{ThemeResource OnTertiaryContainerBrush}" />
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Connection Information Card -->
                <Border Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                  <StackPanel Spacing="0">
                    <!-- Card Header -->
                    <Grid Padding="16,16,16,8">
                      <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE774;"
                                  FontSize="20"
                                  Foreground="{ThemeResource PrimaryBrush}"
                                  Margin="0,0,12,0" />
                        <TextBlock x:Uid="SalesChannelDetailPage.Section.ConnectionInfo"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{ThemeResource OnSurfaceBrush}" />
                      </StackPanel>
                    </Grid>

                    <!-- Connection Fields -->
                    <StackPanel Padding="16,0,16,16"
                                Spacing="16">
                      <!-- URL Field -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE71B;"
                                  FontSize="16"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Url"
                                     Style="{StaticResource LabelSmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding Data.Url}"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource PrimaryBrush}"
                                     IsTextSelectionEnabled="True"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Data.Url, Converter={StaticResource StringToVisibilityConverter}}" />
                          <TextBlock x:Uid="SalesChannelDetailPage.NotAvailable"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     Visibility="{Binding Data.Url, Converter={StaticResource StringToInverseVisibilityConverter}}" />
                        </StackPanel>
                      </Grid>

                      <!-- Username Field -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE77B;"
                                  FontSize="16"
                                  Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Username"
                                     Style="{StaticResource LabelSmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding Data.Username}"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     IsTextSelectionEnabled="True"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Data.Username, Converter={StaticResource StringToVisibilityConverter}}" />
                          <TextBlock x:Uid="SalesChannelDetailPage.NotAvailable"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     Visibility="{Binding Data.Username, Converter={StaticResource StringToInverseVisibilityConverter}}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Synchronization Settings Section Header (hidden for PointOfSale and asShop) -->
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{Binding Data.SalesChannelType, Converter={StaticResource SalesChannelTypeToSyncSettingsVisibilityConverter}}">
                  <FontIcon Glyph="&#xE895;"
                            FontSize="20"
                            Foreground="{ThemeResource SecondaryBrush}" />
                  <TextBlock x:Uid="SalesChannelDetailPage.Section.SyncSettings"
                             Style="{StaticResource TitleMedium}"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                </StackPanel>

                <!-- Synchronization Cards Grid (hidden for PointOfSale and asShop) -->
                <Grid x:Name="SyncGrid"
                      Visibility="{Binding Data.SalesChannelType, Converter={StaticResource SalesChannelTypeToSyncSettingsVisibilityConverter}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SyncColumn1" Width="*" />
                    <ColumnDefinition x:Name="SyncColumn2" Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Import Settings Card -->
                  <Border x:Name="ImportCard"
                          Grid.Column="0"
                          Grid.Row="0"
                          Margin="0,0,8,0"
                          Background="{ThemeResource SurfaceBrush}"
                          CornerRadius="8" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                    <StackPanel Spacing="0">
                      <!-- Card Header -->
                      <Grid Padding="16,16,16,8">
                        <StackPanel Orientation="Horizontal">
                          <FontIcon Glyph="&#xE896;"
                                    FontSize="20"
                                    Foreground="{ThemeResource TertiaryBrush}"
                                    Margin="0,0,12,0" />
                          <TextBlock x:Uid="SalesChannelDetailPage.Section.Import"
                                     Style="{StaticResource TitleMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}" />
                        </StackPanel>
                      </Grid>

                      <!-- Import Settings -->
                      <StackPanel Padding="16,0,16,16"
                                  Spacing="12">
                        <!-- Import Products -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Products"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ImportProducts}" />
                        </Grid>

                        <!-- Import Customers -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Customers"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ImportCustomers}" />
                        </Grid>

                        <!-- Import Saless -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Saless"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ImportSaless}" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Export Settings Card -->
                  <Border x:Name="ExportCard"
                          Grid.Column="1"
                          Grid.Row="0"
                          Margin="8,0,0,0"
                          Background="{ThemeResource SurfaceBrush}"
                          CornerRadius="8" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                    <StackPanel Spacing="0">
                      <!-- Card Header -->
                      <Grid Padding="16,16,16,8">
                        <StackPanel Orientation="Horizontal">
                          <FontIcon Glyph="&#xE898;"
                                    FontSize="20"
                                    Foreground="{ThemeResource TertiaryBrush}"
                                    Margin="0,0,12,0" />
                          <TextBlock x:Uid="SalesChannelDetailPage.Section.Export"
                                     Style="{StaticResource TitleMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}" />
                        </StackPanel>
                      </Grid>

                      <!-- Export Settings -->
                      <StackPanel Padding="16,0,16,16"
                                  Spacing="12">
                        <!-- Export Products -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Products"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ExportProducts}" />
                        </Grid>

                        <!-- Export Customers -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Customers"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ExportCustomers}" />
                        </Grid>

                        <!-- Export Saless -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Uid="SalesChannelDetailPage.Field.Saless"
                                     Grid.Column="0"
                                     Style="{StaticResource BodyMedium}"
                                     Foreground="{ThemeResource OnSurfaceBrush}"
                                     VerticalAlignment="Center" />
                          <controls:StatusBadge Grid.Column="1"
                                  CornerRadius="8"
                                  Padding="10,4"
                                  Status="{Binding Data.ExportSaless}" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Shop Domains Section (asShop only — hidden when the channel has no host bindings) -->
                <StackPanel Spacing="12"
                            Visibility="{Binding Data.ShopDomains.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="12">
                    <FontIcon Glyph="&#xE719;"
                              FontSize="20"
                              Foreground="{ThemeResource SecondaryBrush}" />
                    <TextBlock x:Uid="SalesChannelDetailPage.Section.ShopDomains"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                  </StackPanel>

                  <!-- Shop Domain Table -->
                  <Border CornerRadius="8"
                          BorderBrush="{ThemeResource OutlineVariantBrush}"
                          BorderThickness="1"
                          Background="{ThemeResource SurfaceBrush}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- Table Header -->
                      <Border Grid.Row="0"
                              Background="{ThemeResource SurfaceBrush}"
                              CornerRadius="8,8,0,0"
                              BorderBrush="{ThemeResource OutlineVariantBrush}"
                              BorderThickness="0,0,0,1">
                        <Grid Padding="16,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <FontIcon Grid.Column="0"
                                    Glyph="&#xE774;"
                                    FontSize="16"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1"
                                     x:Uid="SalesChannelDetailPage.Header.ShopDomainHost"
                                     Style="{StaticResource LabelLarge}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <!-- Table Body -->
                      <ItemsRepeater Grid.Row="1"
                                     ItemsSource="{Binding Data.ShopDomains}">
                        <ItemsRepeater.Layout>
                          <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate>
                            <Grid Padding="16,14"
                                  BorderBrush="{ThemeResource OutlineVariantBrush}"
                                  BorderThickness="0,0,0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Border Grid.Column="0"
                                      Width="32"
                                      Height="32"
                                      CornerRadius="16"
                                      Background="{ThemeResource SecondaryContainerBrush}"
                                      Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE774;"
                                          FontSize="14"
                                          Foreground="{ThemeResource OnSecondaryContainerBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Host}"
                                         Style="{StaticResource BodyMedium}"
                                         Foreground="{ThemeResource OnSurfaceBrush}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="2"
                                      Background="{ThemeResource SurfaceVariantBrush}"
                                      CornerRadius="999"
                                      Padding="8,2"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock x:Uid="SalesChannelDetailPage.DomainPrimaryBadge"
                                           Style="{StaticResource LabelSmall}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Warehouses Section -->
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal"
                              Spacing="12">
                    <FontIcon Glyph="&#xE80F;"
                              FontSize="20"
                              Foreground="{ThemeResource SecondaryBrush}" />
                    <TextBlock x:Uid="SalesChannelDetailPage.Section.Warehouses"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                  </StackPanel>

                  <!-- Warehouse Table -->
                  <Border CornerRadius="8"
                          BorderBrush="{ThemeResource OutlineVariantBrush}"
                          BorderThickness="1"
                          Background="{ThemeResource SurfaceBrush}"
                          Visibility="{Binding Data.Warehouses.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- Table Header -->
                      <Border Grid.Row="0"
                              Background="{ThemeResource SurfaceBrush}"
                              CornerRadius="8,8,0,0"
                              BorderBrush="{ThemeResource OutlineVariantBrush}"
                              BorderThickness="0,0,0,1">
                        <Grid Padding="16,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <FontIcon Grid.Column="0"
                                    Glyph="&#xE80F;"
                                    FontSize="16"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1"
                                     x:Uid="SalesChannelDetailPage.Header.WarehouseName"
                                     Style="{StaticResource LabelLarge}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <!-- Table Body -->
                      <ItemsRepeater Grid.Row="1"
                                     ItemsSource="{Binding Data.Warehouses}">
                        <ItemsRepeater.Layout>
                          <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate>
                            <Grid Padding="16,14"
                                  BorderBrush="{ThemeResource OutlineVariantBrush}"
                                  BorderThickness="0,0,0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>

                              <Border Grid.Column="0"
                                      Width="32"
                                      Height="32"
                                      CornerRadius="16"
                                      Background="{ThemeResource SecondaryContainerBrush}"
                                      Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE80F;"
                                          FontSize="14"
                                          Foreground="{ThemeResource OnSecondaryContainerBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Name}"
                                         Style="{StaticResource BodyMedium}"
                                         Foreground="{ThemeResource OnSurfaceBrush}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </Grid>
                  </Border>

                  <!-- No Warehouses Placeholder -->
                  <Border Background="{ThemeResource SurfaceVariantBrush}"
                          CornerRadius="8"
                          Padding="24"
                          Visibility="{Binding Data.Warehouses.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="8">
                      <FontIcon Glyph="&#xE80F;"
                                FontSize="32"
                                Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock x:Uid="SalesChannelDetailPage.NoWarehouses"
                                 Style="{StaticResource BodyMedium}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Usage Hint Card — talks about syncing with external platforms, so it is
                     hidden for the internal channel types (PointOfSale, asShop) -->
                <Border Background="{ThemeResource SecondaryContainerBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{Binding Data.SalesChannelType, Converter={StaticResource SalesChannelTypeToSyncSettingsVisibilityConverter}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE946;"
                              FontSize="20"
                              Foreground="{ThemeResource OnSecondaryContainerBrush}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1"
                               x:Uid="SalesChannelDetailPage.UsageHint"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSecondaryContainerBrush}"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>

              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>

      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <Grid HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <ProgressRing IsActive="True"
                            Width="48"
                            Height="48" />
              <TextBlock x:Uid="Common.Loading"
                         Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <Grid HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <FontIcon Glyph="&#xE783;"
                        FontSize="48"
                        Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock x:Uid="SalesChannelDetailPage.LoadError"
                         Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Center" />
              <Button x:Uid="Common.Retry"
                      Style="{StaticResource FilledButtonStyle}"
                      HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
      </Grid>

      <!-- Tab: Log (paginated, filterable sync-log table) -->
      <Grid x:Name="LogTab"
            Visibility="Collapsed"
            Padding="24,16,24,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter bar: message search, minimum level, refresh -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16"
              ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="LogSearchBox"
                   Grid.Column="0"
                   x:Uid="SalesChannelDetailPage.LogSearch"
                   TextChanged="LogSearchBox_TextChanged" />

          <ComboBox x:Name="LogLevelComboBox"
                    Grid.Column="1"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    SelectedIndex="0"
                    SelectionChanged="LogLevelComboBox_SelectionChanged">
            <ComboBoxItem x:Uid="SalesChannelDetailPage.LogLevelAll" />
            <ComboBoxItem x:Uid="SalesChannelDetailPage.LogLevelInformation" />
            <ComboBoxItem x:Uid="SalesChannelDetailPage.LogLevelWarning" />
            <ComboBoxItem x:Uid="SalesChannelDetailPage.LogLevelError" />
          </ComboBox>

          <Button Grid.Column="2"
                  x:Uid="SalesChannelDetailPage.LogRefresh"
                  Style="{StaticResource IconButtonStyle}"
                  VerticalAlignment="Center"
                  Click="RefreshLogs_Click">
            <FontIcon Glyph="&#xE72C;"
                      FontSize="16" />
          </Button>
        </Grid>

        <!-- Log table -->
        <Border Grid.Row="1"
                Style="{StaticResource TableCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Border Grid.Row="0"
                    Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="8,8,0,0"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1">
              <Grid Padding="16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Uid="SalesChannelDetailPage.LogHeader.Timestamp"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="1"
                           x:Uid="SalesChannelDetailPage.LogHeader.Level"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="2"
                           x:Uid="SalesChannelDetailPage.LogHeader.Operation"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="3"
                           x:Uid="SalesChannelDetailPage.LogHeader.Message"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </Grid>
            </Border>

            <!-- Table Body -->
            <mvux:FeedView x:Name="LogsFeedView"
                           Grid.Row="1"
                           Source="{Binding SyncLogs}">
              <mvux:FeedView.ValueTemplate>
                <DataTemplate>
                  <ListView ItemsSource="{Binding Data}"
                            Style="{StaticResource TableListViewStyle}"
                            ItemContainerStyle="{StaticResource TableItemContainerStyle}"
                            SelectionMode="None">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="dtos:ChannelSyncLogDto">
                        <Grid BorderBrush="{ThemeResource OutlineVariantBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="16,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0"
                                     Text="{x:Bind models:SyncLogRowVisuals.FormatTimestamp(Timestamp)}"
                                     Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1"
                                     Text="{x:Bind Level}"
                                     Style="{StaticResource BodySmall}"
                                     Foreground="{x:Bind Level, Converter={StaticResource SyncLogLevelToForegroundConverter}}"
                                     VerticalAlignment="Top" />
                          <TextBlock Grid.Column="2"
                                     Text="{x:Bind Operation}"
                                     Style="{StaticResource BodySmall}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Top" />
                          <StackPanel Grid.Column="3"
                                      Spacing="2">
                            <TextBlock Text="{x:Bind Message}"
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Exception}"
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{ThemeResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind Exception, Converter={StaticResource StringToVisibilityConverter}}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </DataTemplate>
              </mvux:FeedView.ValueTemplate>

              <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                  <ProgressRing IsActive="True"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="48" />
                </DataTemplate>
              </mvux:FeedView.ProgressTemplate>

              <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                  <controls:EmptyState x:Uid="SalesChannelDetailPage.NoLogs"
                                       Glyph="&#xE9D9;" />
                </DataTemplate>
              </mvux:FeedView.NoneTemplate>
            </mvux:FeedView>
          </Grid>
        </Border>

        <!-- Pagination Controls -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Count Info (Left) -->
            <mvux:FeedView Source="{Binding LogPagination}"
                           Grid.Column="0">
              <mvux:FeedView.ValueTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Data.CountInfo}"
                             Style="{StaticResource BodySmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </mvux:FeedView.ValueTemplate>
            </mvux:FeedView>

            <!-- Page Navigation (Center) -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <Button x:Uid="SalesChannelDetailPage.PreviousLogPage"
                      Style="{StaticResource IconButtonStyle}"
                      Click="PreviousLogPage_Click">
                <FontIcon Glyph="&#xE76B;"
                          FontSize="16" />
              </Button>

              <mvux:FeedView Source="{Binding LogPagination}">
                <mvux:FeedView.ValueTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Data.PageInfo}"
                               Style="{StaticResource BodyMedium}"
                               VerticalAlignment="Center"
                               MinWidth="100"
                               TextAlignment="Center" />
                  </DataTemplate>
                </mvux:FeedView.ValueTemplate>
              </mvux:FeedView>

              <Button x:Uid="SalesChannelDetailPage.NextLogPage"
                      Style="{StaticResource IconButtonStyle}"
                      Click="NextLogPage_Click">
                <FontIcon Glyph="&#xE76C;"
                          FontSize="16" />
              </Button>
            </StackPanel>

            <!-- Page Size Selection (Right) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <TextBlock x:Uid="SalesChannelDetailPage.LogItemsPerPage"
                         Style="{StaticResource BodySmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         VerticalAlignment="Center" />
              <ComboBox x:Name="LogPageSizeComboBox"
                        Style="{StaticResource PageSizeComboBoxStyle}"
                        SelectionChanged="LogPageSizeComboBox_SelectionChanged"
                        SelectedIndex="1">
                <ComboBoxItem Content="25" Tag="25" />
                <ComboBoxItem Content="50" Tag="50" />
                <ComboBoxItem Content="100" Tag="100" />
                <ComboBoxItem Content="200" Tag="200" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
