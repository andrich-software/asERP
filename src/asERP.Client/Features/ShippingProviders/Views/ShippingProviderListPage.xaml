<Page x:Class="asERP.Client.Features.ShippingProviders.Views.ShippingProviderListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:asERP.Client.Features.ShippingProviders.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:asERP.Client.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" x:Uid="ShippingProviderListPage.PageHeader"
                         Glyph="&#xE7B8;" Margin="16,0">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Style="{StaticResource HeaderActionButtonStyle}"
                  x:Uid="ShippingProviderListPage.RefreshButton" Click="Refresh_Click">
            <FontIcon Glyph="&#xE72C;" FontSize="16" />
          </Button>
          <Button x:Uid="ShippingProviderListPage.HeaderButton.New"
                  Style="{StaticResource HeaderActionSaveButtonStyle}"
                  Click="CreateProvider_Click" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!-- Error banner -->
    <Border Grid.Row="1" Background="{ThemeResource ErrorContainerBrush}"
            CornerRadius="8" Padding="12" Margin="16,8,16,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnErrorContainerBrush}" TextWrapping="Wrap" />
    </Border>

    <!-- Carrier table -->
    <Border Grid.Row="2" Margin="16,8,16,16" Style="{StaticResource TableCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8,8,0,0"
                BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
          <Grid Padding="16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Uid="ShippingProviderListPage.ColumnName"
                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" x:Uid="ShippingProviderListPage.ColumnType"
                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" x:Uid="ShippingProviderListPage.ColumnStatus"
                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" x:Uid="ShippingProviderListPage.ColumnSandbox"
                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" x:Uid="ShippingProviderListPage.ColumnRates"
                       Style="{StaticResource BodyMedium}" FontWeight="SemiBold"
                       HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <ListView ItemsSource="{Binding Rows}"
                    Style="{StaticResource TableListViewStyle}"
                    ItemContainerStyle="{StaticResource TableItemContainerStyle}"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    ItemClick="ProviderRow_Click">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ShippingProviderRow">
                <Grid Padding="16,14"
                      BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                             Style="{StaticResource BodyMedium}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind TypeDisplay}"
                             Style="{StaticResource BodyMedium}" VerticalAlignment="Center" />
                  <controls:StatusBadge Grid.Column="2" Status="{x:Bind IsEnabled}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             x:Uid="ShippingProviderListPage.SandboxBadge"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Center"
                             Visibility="{x:Bind UseSandbox}" />
                  <TextBlock Grid.Column="4" Text="{x:Bind RateCount}"
                             Style="{StaticResource BodyMedium}" VerticalAlignment="Center"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <controls:EmptyState x:Uid="ShippingProviderListPage.NoProviders" Glyph="&#xE7B8;"
                               Background="Transparent" VerticalAlignment="Center"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}" />

          <ProgressRing IsActive="{Binding IsLoading}" Width="48" Height="48"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
